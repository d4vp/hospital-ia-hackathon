# =====================  MongoDB  =====================
MONGO_URI=mongodb://localhost:27017
DB_NAME=hospital_susana_lopez
# Recommended: a MongoDB user with ONLY the built-in `read` role, used for every query the
# AI agent runs (server-side read-only guarantee). Empty = read-only facade on MONGO_URI.
MONGO_READONLY_URI=

# =====================  SQL Server (system of record)  =====
# Empty host = "mongo_only": records inserted from the app go only to MongoDB.
# Use the least-privilege login from docs/sqlserver/schema.sql (SELECT + INSERT, no UPDATE/DELETE).
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=HIS
SQLSERVER_USER=hospital_app
SQLSERVER_PASSWORD=
SQLSERVER_SCHEMA=dbo
SQLSERVER_TIMEOUT_SECONDS=15
# Only for the optional local container (docker compose --profile sqlserver)
MSSQL_SA_PASSWORD=
HOSPITAL_TIMEZONE=America/Bogota
RECORDS_MAX_BACKDATE_DAYS=30
SYNC_RETRY_INTERVAL_SECONDS=120

# =====================  OpenAI  ======================
# Leave empty to run the agent in "Plan B" mode (predefined queries, no external API).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=30

# =====================  Security  ====================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRE_MINUTES=480
# Comma-separated list of allowed browser origins (no "*").
CORS_ORIGINS=http://localhost:8501
# First admin account, created automatically only if the users collection is empty.
BOOTSTRAP_ADMIN_EMAIL=admin@hospital.local
BOOTSTRAP_ADMIN_PASSWORD=Admin/1234
BOOTSTRAP_ADMIN_NAME=Administrator

# =====================  Data loading  ================
DATA_DIR=app/data
EXCEL_FILENAME=DateBaseHIS.xlsx
MAX_UPLOAD_MB=120
# Real bed capacity per bed group (JSON). Empty = use distinct beds observed in the data.
BED_CAPACITY_OVERRIDES=
QUERY_MAX_TIME_MS=8000

# =====================  Agent  =======================
CHAT_MEMORY_TURNS=6
DEFAULT_LANGUAGE=es
CHAT_MAX_ANSWER_TOKENS=450

# =====================  Caches (seconds)  ============
# Dataset-derived caches are keyed by the ETL run id (never stale); the TTL only bounds memory.
CACHE_TTL_SECONDS=3600
# Identical context-free questions are answered from memory for this long.
CHAT_CACHE_TTL_SECONDS=900
METADATA_CACHE_TTL_SECONDS=5

# =====================  Billing (optional)  ==========
BILLING_ENABLED=true
BILLING_CURRENCY=COP
# Unit prices per CUPS / medication code (+ "default"). Empty = volumes only, no amounts.
# e.g. {"services": {"default": 0, "890201": 35000}, "medications": {"default": 0}}
BILLING_TARIFFS=

# =====================  Alerts / n8n  ================
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# true = build the n8n payloads but do not send them (simulated success). For demos without n8n.
N8N_DRY_RUN=false
ALERT_LANGUAGE=es
ALERT_CHECK_INTERVAL_SECONDS=900
ALERT_OCCUPANCY_THRESHOLD_PCT=85
ALERT_INVENTORY_DAYS_THRESHOLD=5
ALERT_ER_WAIT_THRESHOLD_MIN=60
ALERT_TRIAGE2_WAIT_THRESHOLD_MIN=30
ALERT_SURGERY_COMPLETION_THRESHOLD_PCT=70

# =====================  n8n AI agent integration  ====
# Shared secret (>= 32 chars) that n8n sends in X-Integration-Key. Empty = integration disabled.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTEGRATION_API_KEY=

# =====================  Request shield  ==============
API_MAX_JSON_BYTES=65536
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MIN=300
RATE_LIMIT_AGENT_PER_MIN=30
RATE_LIMIT_LOGIN_PER_MIN=20
RATE_LIMIT_WRITE_PER_MIN=60

# =====================  Logging  =====================
LOG_LEVEL=INFO

# =====================  Frontend -> Backend  =========
API_BASE_URL=http://localhost:8000/api
